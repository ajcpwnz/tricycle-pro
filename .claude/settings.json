{
  "permissions": {
    "allow": ["Edit", "Write", "Bash(git:*)", "Bash(cd:*)", "Bash(ls:*)", "Bash(cp:*)", "Bash(mkdir:*)", "Bash(npm:*)", "Bash(npx:*)", "Bash(node:*)", "Bash(./scripts:*)"]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/rename-on-kickoff.sh", "timeout": 5},
          {"type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/graphify-refresh-on-kickoff.sh", "timeout": 5}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash|mcp__.*__(save|create)_(issue|comment)",
        "hooks": [
          {"type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/style-gate.sh", "timeout": 30}
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.sh", "timeout": 10}
        ]
      }
    ]
  }
}
